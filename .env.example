# Copie para .env (que está no .gitignore) ou exporte no terminal. Nunca faça commit da chave.
# Copy to .env (git-ignored) or export in your shell. Never commit the key.

# --- Google Gemini, plano gratuito (padrão) / free tier (default) ---
# Chave em / key at: https://aistudio.google.com/app/apikey  (sem cobrança / no billing needed)
# Limites por modelo / per-model limits: https://aistudio.google.com/rate-limit
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
# Aceito pelo Gemini; outros provedores podem rejeitar: deixe vazio se der erro.
# Accepted by Gemini; other providers may reject it: leave empty if it errors.
LLM_REASONING_EFFORT=low

# --- Alternativa: Groq, plano gratuito / free tier (https://console.groq.com) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=

# --- Comportamento / behaviour ---
# LLM_TEMPERATURE=0.4
# AGENT_MAX_TOOL_ROUNDS=8
# LLM_MAX_RETRIES=4
# Pausa entre chamadas (s), útil no plano gratuito para não estourar o limite por minuto.
# Pause between calls (s), useful on free tiers to stay under per-minute limits.
LLM_MIN_SECONDS_BETWEEN_CALLS=7
# Fixa a data da loja (AAAA-MM-DD) para demonstrações; vazio = data real.
# Pins the store date (YYYY-MM-DD) for demos; empty = real date.
# STORE_TODAY=2026-03-23
